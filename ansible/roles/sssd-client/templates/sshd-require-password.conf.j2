{# sshd-require-password.conf.j2 - Force SSH authentication to end in the PAM #}
{# stack so pam_sss mints a Kerberos TGT.  Deployed only when              #}
{# sssd_ssh_require_password is true.  See docs/SCENARIOS.md.              #}
# Managed by the sssd-client role -- do not edit.
#
# Public-key authentication never runs sshd's PAM auth stack, so pam_sss never
# sees a password and no Kerberos TGT is issued.  With NFSv4 sec=krb5p home
# directories and shares, every access under the mount needs a *user* GSS
# context, so a key-only login lands in a home directory it cannot read.  The
# mount itself succeeds -- autofs uses the machine credential from
# /etc/krb5.keytab -- which makes a missing ticket look like a mount failure.
#
# Two alternatives are accepted: publickey followed by a PAM password, or a PAM
# password alone for users with no key.  Either way the final step runs the PAM
# stack, so a TGT exists before the session (and therefore the home directory)
# is opened.  Nothing here modifies PAM itself: the existing stack is reused,
# and PAM remains managed exclusively through pam-auth-update.
KbdInteractiveAuthentication yes
AuthenticationMethods publickey,keyboard-interactive:pam keyboard-interactive:pam
{% if _sssd_ssh_exempt | length > 0 %}

# Automation stays key-only.  Without this, the next Ansible run hangs on a
# password prompt, and the DC's root SSH for cross-host home-directory
# management (samba-user.sh) stops working.
Match User {{ _sssd_ssh_exempt | join(',') }}
    AuthenticationMethods publickey
{% endif %}

# Terminate the Match block.  /etc/ssh/sshd_config carries its
# `Include /etc/ssh/sshd_config.d/*.conf` near the TOP of the file, so a drop-in
# that ends inside a Match would silently scope every directive in the rest of
# the main configuration to that match.
Match all
